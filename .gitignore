# --- Gradle ---
.gradle/
build/
!gradle/wrapper/gradle-wrapper.jar
!gradle/wrapper/gradle-wrapper.properties

# --- Java ---
*.class
*.jar
!gradle/wrapper/gradle-wrapper.jar
*.war
*.log
hs_err_pid*
replay_pid*

# --- IntelliJ IDEA ---
.idea/
*.iml
*.iws
*.ipr
out/

# --- VS Code ---
# Shared workspace config IS committed: formatting rules and extension
# recommendations must be identical for every contributor, or "it formats
# differently on my machine" becomes a review comment. Note the glob is
# .vscode/* not .vscode/ -- git will not descend into an ignored directory,
# so a trailing-slash pattern makes the negations below unreachable.
.vscode/*
!.vscode/settings.json
!.vscode/extensions.json

# --- Eclipse ---
.classpath
.project
.settings/
bin/

# --- OS ---
.DS_Store
Thumbs.db
desktop.ini

# --- Secrets ---
# Never commit these. If one slips in, rotating the credential is the fix —
# deleting the file in a later commit does not remove it from history.
.env
*.env
!.env.example
application-local.yml
application-secrets.yml
src/main/resources/application-local.properties

# --- Test and report output ---
/reports/
*.exec

# Machine-specific Gradle config
gradle.properties

# Captured build output from debugging sessions
build-error.txt
