{
  // Workspace formatting rules for BugTrail.
  //
  // Committed on purpose. Formatting that lives only on one developer's
  // machine is a preference, not a standard -- and the diffs it produces are
  // noise every reviewer reads past.
  //
  // Indent width, line endings, trailing whitespace and the final newline
  // come from .editorconfig at the repo root. This file turns enforcement ON
  // and tells VS Code which formatter owns Java files.

  "editor.formatOnSave": true,
  "editor.formatOnPaste": false,

  "files.trimTrailingWhitespace": true,
  "files.insertFinalNewline": true,
  "files.trimFinalNewlines": true,
  "files.eol": "\n",

  // Autosave is OFF on purpose. With autosave on, VS Code writes the file
  // before you press Ctrl+S, which leaves the document clean -- so the manual
  // save becomes a no-op and format-on-save never fires at all. Saving should
  // be deliberate: it is the moment formatting, import organising and the
  // language server all run. It also keeps unsaved work visible as a dirty
  // dot on the tab instead of quietly writing itself over something.
  "files.autoSave": "off",

  "[java]": {
    "editor.defaultFormatter": "redhat.java",
    "editor.tabSize": 4,
    "editor.insertSpaces": true,
    "editor.rulers": [120]
  },

  // Markdown uses two trailing spaces as a hard line break, so trimming them
  // would silently change rendered output.
  "[markdown]": {
    "files.trimTrailingWhitespace": false
  },

  "java.format.enabled": true,
  "java.saveActions.organizeImports": true,
  "java.completion.importOrder": ["java", "javax", "jakarta", "org", "com", ""],
  "java.configuration.updateBuildConfiguration": "automatic",

  // Keep generated output out of the file tree and search results.
  "files.exclude": {
    "**/.gradle": true,
    "**/build": true,
    "**/bin": true
  },
  "search.exclude": {
    "**/build": true,
    "**/.gradle": true
  }
}
