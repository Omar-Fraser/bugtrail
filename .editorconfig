# Formatting rules for BugTrail, versioned with the code so every contributor
# and every editor agrees. Supported natively by IntelliJ and by the
# "EditorConfig for VS Code" extension.

root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 4

[*.java]
indent_size = 4
max_line_length = 120

[*.{yml,yaml,json}]
indent_size = 2

[*.sql]
indent_size = 4

[*.md]
# Markdown uses trailing double-space for hard line breaks.
trim_trailing_whitespace = false

[*.{bat,cmd}]
end_of_line = crlf

[Makefile]
indent_style = tab
